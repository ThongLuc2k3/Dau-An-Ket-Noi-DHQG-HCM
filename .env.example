# Tài khoản quản trị môi trường
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Lưu trữ Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
