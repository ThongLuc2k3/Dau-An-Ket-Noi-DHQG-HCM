# Frontend (chỉ các biến VITE_ được đưa vào bundle trình duyệt)
VITE_API_BASE_URL=http://localhost:4100/api
VITE_PUBLIC_APP_URL=http://localhost:5173

# Backend bắt buộc
DATABASE_URL=
JWT_SECRET=
