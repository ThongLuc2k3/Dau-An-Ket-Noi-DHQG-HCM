    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.6.2",
    "vite": "^6.1.0"
